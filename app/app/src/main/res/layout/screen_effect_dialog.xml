<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow layout (portrait phones): single stacked column inside a vertical
    ScrollView so every option (including Frame Generation) stays reachable
    when the viewport height is short. All IDs match layout-w600dp variant. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brightness" />

                    <com.winlator.widget.SeekBar
                        android:id="@+id/SBBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:minValue="-50"
                        app:maxValue="50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contrast" />

                    <com.winlator.widget.SeekBar
                        android:id="@+id/SBContrast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:minValue="-100"
                        app:maxValue="100" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gamma" />

                    <com.winlator.widget.SeekBar
                        android:id="@+id/SBGamma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:step="0.01"
                        app:minValue="0.5"
                        app:maxValue="3.0" />
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/color_adjustment"
                    android:background="?attr/colorSecondarySurface" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Spinner
                    style="@style/ComboBox"
                    android:id="@+id/SProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <LinearLayout style="@style/Toolbox">
                    <ImageButton
                        style="@style/ListMenuButton"
                        android:id="@+id/BTAddProfile"
                        android:src="@drawable/icon_add" />

                    <ImageButton
                        style="@style/ListMenuButton"
                        android:id="@+id/BTRemoveProfile"
                        android:layout_marginRight="0dp"
                        android:src="@drawable/icon_remove" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/CBEnableFXAA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_fxaa"
                android:layout_marginTop="8dp" />

            <CheckBox
                android:id="@+id/CBEnableCRTShader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_crt_shader" />

            <CheckBox
                android:id="@+id/CBEnableHDR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_hdr" />

            <TextView
                android:id="@+id/TVHDRIntensity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hdr_intensity"
                android:visibility="gone"
                android:layout_marginTop="4dp" />

            <com.winlator.widget.SeekBar
                android:id="@+id/SBHDRIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:minValue="1"
                app:maxValue="100"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/CBEnableToonShader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_toon_shader"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/TVToonIntensity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toon_intensity"
                android:visibility="gone"
                android:layout_marginTop="4dp" />

            <com.winlator.widget.SeekBar
                android:id="@+id/SBToonIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:minValue="1"
                app:maxValue="100"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fps_limiter"
                android:layout_marginTop="8dp" />

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SFpsLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/CBEnableFramePacing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_frame_pacing"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/BTFrameGeneration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frame_generation"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/BTHUDConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hud_configuration"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
