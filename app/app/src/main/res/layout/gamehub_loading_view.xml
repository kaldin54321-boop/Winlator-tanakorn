<?xml version="1.0" encoding="utf-8"?>
<!-- GameHub-style launching overlay: shown after the shortcut preloader while
    the XServer / Wine services initialize, hidden when the game window maps. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gamehub_loading_background">

    <!-- Controller notice, top-right. Shown only when the shortcut has an
        input-controls profile selected; the name is set at runtime. -->
    <LinearLayout
        android:id="@+id/PillGameHubController"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:background="@drawable/gamehub_pill_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#127918;"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_connected"
                android:textSize="13sp"
                android:textColor="#9aa3b2" />

            <TextView
                android:id="@+id/TVGameHubControllerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/virtual_controller"
                android:textSize="17sp"
                android:textColor="#ffffff" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center: Windows logo <-> game icon, status text, progress bar. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/IVGameHubWindows"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_windows_logo"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/TVGameHubSwap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:text="&#8646;"
                android:textSize="32sp"
                android:textColor="#ffffff" />

            <ImageView
                android:id="@+id/IVGameHubIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/TVGameHubStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="@string/launching_game"
            android:textSize="19sp"
            android:textColor="#ffffff" />

        <ProgressBar
            android:id="@+id/PBGameHubProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="320dp"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/gamehub_loading_progress" />
    </LinearLayout>

    <!-- Small branding mark, bottom-right. -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/icon_notification"
        android:contentDescription="@null" />

</FrameLayout>
