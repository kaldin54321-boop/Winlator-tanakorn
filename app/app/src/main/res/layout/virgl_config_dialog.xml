<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SVersion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                style="@style/Toolbox"
                android:id="@+id/VirGLToolbox">

                <ImageButton
                    style="@style/ListMenuButton"
                    android:src="@drawable/icon_install"
                    android:tag="install" />

                <ImageButton
                    style="@style/ListMenuButton"
                    android:layout_marginRight="0dp"
                    android:src="@drawable/icon_remove"
                    android:tag="remove" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/opengl_version" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SGLVersion"
            android:entries="@array/opengl_version_entries" />

        <CheckBox
            android:id="@+id/CBDisableVertexArrayBGRA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disable_vertex_array_bgra"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/CBDisableKHRDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disable_khr_debug"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/CBDisableTextureSRGBDecode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disable_texture_srgb_decode"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
