<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SVersion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                style="@style/Toolbox"
                android:id="@+id/VegasToolbox">

                <ImageButton
                    style="@style/ListMenuButton"
                    android:src="@drawable/icon_install"
                    android:contentDescription="@null"
                    android:tag="install" />

                <ImageButton
                    style="@style/ListMenuButton"
                    android:layout_marginEnd="0dp"
                    android:src="@drawable/icon_remove"
                    android:contentDescription="@null"
                    android:tag="remove" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vegas_config_file" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SVegasConfigFile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:entries="@array/vegas_config_file_entries" />

            <LinearLayout
                style="@style/Toolbox"
                android:id="@+id/ConfigDownloadToolbox">

                <ImageButton
                    style="@style/ListMenuButton"
                    android:id="@+id/BTDownloadConfig"
                    android:layout_marginEnd="0dp"
                    android:src="@drawable/icon_popup_menu_download"
                    android:contentDescription="@null"
                    android:tag="download_config" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ddraw_wrapper" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SDDrawWrapper"
            android:entries="@array/ddraw_wrapper_entries" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frame_rate" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SFramerate"
            android:entries="@array/dxvk_framerate_entries" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/max_device_memory" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SMaxDeviceMemory"
            android:entries="@array/max_device_memory_entries" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/custom_device" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SCustomDevice" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dxvk_hud" />

        <com.winlator.widget.MultiSelectionComboBox
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/MSCBDxvkHud" />
    </LinearLayout>
</ScrollView>