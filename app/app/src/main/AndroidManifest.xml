<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.winlator">
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:allowAudioPlaybackCapture="true"
        android:label="@string/app_name">

        <activity android:name="com.winlator.MainActivity"
            android:theme="@style/AppThemeDark"
            android:exported="true"
            android:screenOrientation="sensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name="com.winlator.XServerDisplayActivity"
            android:exported="true"
            android:theme="@style/AppThemeFullscreenDark"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation"
            android:screenOrientation="sensorLandscape" />

        <activity android:name="com.winlator.ControlsEditorActivity"
            android:exported="false"
            android:theme="@style/AppThemeFullscreenDark"
            android:screenOrientation="sensorLandscape" />

        <activity android:name="com.winlator.ExternalControllerBindingsActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="sensor" />

        <activity android:name="com.winlator.IconPacksActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="sensor" />

        <activity android:name="com.winlator.IconPackEditorActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="sensor" />

        <activity android:name="com.winlator.saves.CustomFilePickerActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="sensor" />

        <!-- Game Stores hub (Steam / GOG / Epic / Amazon): login, library, download
             and shortcut creation. All UIs are built programmatically. -->
        <activity android:name="com.winlator.store.GogMainActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.GogLoginActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.GogGamesActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.GogGameDetailActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.EpicMainActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.EpicLoginActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.EpicGamesActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.EpicGameDetailActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.EpicFreeGamesActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.AmazonMainActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.AmazonLoginActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.AmazonGamesActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.AmazonGameDetailActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.FolderPickerActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.SteamMainActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.SteamLoginActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.SteamGamesActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.SteamGameDetailActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity android:name="com.winlator.store.QrLoginActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <service android:name="com.winlator.store.SteamForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Needed for keep the container alive when in background or the device is locked. -->
        <service
            android:name="com.winlator.services.ForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.winlator.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>
</manifest>
